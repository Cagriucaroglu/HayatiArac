# Bu dosya sadece bir ŞABLONDUR — commit edilen bir örnek, gerçek sırları içermez.
#
# Sunucuda (WSL provası veya gerçek VPS) şu adımlarla gerçek dosyayı oluşturun:
#   sudo mkdir -p /etc/hayatiarac
#   sudo cp deploy/hayatiarac-api.env.example /etc/hayatiarac/hayatiarac-api.env
#   sudo nano /etc/hayatiarac/hayatiarac-api.env   # gerçek değerleri girin
#   sudo chmod 600 /etc/hayatiarac/hayatiarac-api.env
#
# /etc/hayatiarac/hayatiarac-api.env dosyası ASLA git'e commit edilmez
# (gerçek VPS'te sadece sunucunun diskinde durur, repo bunu hiç bilmez).

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000

# Dikkat: EnvironmentFile formatında değerler TIRNAKSIZ yazılır (systemd Environment=
# satırındaki boşluk-bölme sorunu burada yoktur, her satır tek bir KEY=VALUE'dur).
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=HayatiAracDb;User Id=sa;Password=DEGISTIR;TrustServerCertificate=True;MultipleActiveResultSets=true
ConnectionStrings__Redis=localhost:6379

RabbitMQ__Host=rabbitmq://localhost
RabbitMQ__Username=guest
RabbitMQ__Password=DEGISTIR
